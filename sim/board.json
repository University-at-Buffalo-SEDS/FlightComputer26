  "peripherals": [
    {
      "type": "imu",
      "name": "flight_imu",
      "failure_every": 997
    },
    {
      "type": "barometer",
      "name": "flight_barometer",
      "disconnect_after": 950
    },
    {
      "type": "adc",
      "name": "flight_adc",
      "bits": 12,
      "channels": 4
    }
  ]
