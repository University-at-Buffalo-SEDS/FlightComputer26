{
  "name": "FlightComputer26",
  "architecture": "stm32h5",
  "mcu": "stm32h523",
  "memory": {
    "flash_base": 134217728,
    "flash_size": 524288,
    "ram_regions": [
      {"name": "sram", "base": 536870912, "size": 208896},
      {"name": "dma_sram", "base": 537079808, "size": 69632}
    ],
    "bootloader_size": 16384,
    "slot_a_base": 134234112,
    "slot_a_size": 475136,
    "erase_size": 8192,
    "write_alignment": 16,
    "sedsnet_pool": 1024
  },
  "artifacts": {
    "elf": "build/Release/FlightComputer26.elf",
    "bootloader_elf": "build/Release/FlightComputer26Bootloader.elf",
    "firmware": "build/Release/FlightComputer26.launchcore.img",
    "bootloader": "build/Release/FlightComputer26Bootloader.bin",
    "factory": "build/Release/FlightComputer26.factory.bin",
    "ota": "build/Release/FlightComputer26.seds"
  },
  "board": {
    "strict_mmio": false,
    "clocks": [],
    "connections": [],
    "pins": [],
    "dma_routes": [],
    "security": {"trustzone": false, "secure_regions": []}
  },
  "execution": {
    "virtual_time_ms": 250,
    "sample_count": 1,
    "memory_probes": [
      {"name": "network_ready", "symbol": "g_telemetry_network_ready"},
      {"name": "discovery_seen", "symbol": "g_telemetry_discovery_seen"},
      {"name": "timesync_valid", "symbol": "g_telemetry_timesync_valid"},
      {"name": "pool_available", "symbol": "g_telemetry_pool_available", "minimum": 4096, "max_end_drop": 1024},
      {"name": "pool_low_water", "symbol": "g_telemetry_pool_low_water", "minimum": 2048},
      {"name": "alloc_failures", "symbol": "g_telemetry_alloc_fail", "maximum": 0},
      {"name": "panics", "symbol": "g_telemetry_panic_count", "maximum": 0},
      {"name": "startup_fault_stage", "symbol": "g_startup_fault_stage", "maximum": 0},
      {"name": "alloc_fallback_failures", "symbol": "alloc_leaks", "maximum": 0},
      {"name": "lock_get_failures", "symbol": "lock_fails", "maximum": 0},
      {"name": "lock_put_failures", "symbol": "unlock_fails", "maximum": 0},
      {"name": "fdcan_irqs", "symbol": "g_fdcan_irq_count"},
      {"name": "fdcan_rx", "symbol": "g_fdcan_rx_count"},
      {"name": "fdcan_tx_ok", "symbol": "g_fdcan_tx_ok_count"},
      {"name": "fdcan_tx_fail", "symbol": "g_fdcan_tx_fail_count", "maximum": 0},
      {"name": "fdcan_last_error", "symbol": "g_fdcan_last_error"},
      {"name": "fdcan_last_state", "symbol": "g_fdcan_last_state"},
      {"name": "queue_errors", "symbol": "g_telemetry_queue_errors"},
      {"name": "discovery_poll_errors", "symbol": "g_telemetry_discovery_poll_errors"},
      {"name": "timesync_poll_errors", "symbol": "g_telemetry_timesync_poll_errors"},
      {"name": "allocations", "symbol": "g_telemetry_alloc_count"},
      {"name": "frees", "symbol": "g_telemetry_free_count"}
    ]
  },
  "traffic": {
    "iterations": 100000,
    "max_payload": 512,
    "queue_depth": 0,
    "immediate_dispatch": true
  },
  "ota": {
    "chunk_size": 512
  },
  "peripherals": [
    {
      "type": "imu",
      "name": "flight_imu",
      "model": "bmi088",
      "bus": "spi1",
      "failure_every": 997,
      "disconnect_after": 950
    },
    {
      "type": "barometer",
      "name": "flight_barometer",
      "model": "bmp390",
      "bus": "spi1",
      "failure_every": 997,
      "disconnect_after": 950
    },
    {
      "type": "storage",
      "name": "sd_card",
      "model": "sd_card",
      "bus": "sdmmc1",
      "capacity_bytes": 4194304
    }
  ]
}
